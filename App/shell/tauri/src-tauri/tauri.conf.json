{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memmy Turbo",
  "version": "1.2.4",
  "identifier": "com.theerasakping.memmy.turbo",
  "build": {
    "frontendDist": "../../../frontend/desktop/dist",
    "devUrl": "http://127.0.0.1:19000",
    "beforeDevCommand": "npm --prefix ../../.. run dev -w @memmy/frontend-desktop -- --host 127.0.0.1",
    "beforeBuildCommand": "npm --prefix ../../.. run build -w @memmy/frontend-desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Memmy",
        "width": 1200,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 14, "y": 14 },
        "backgroundColor": "#f1f8f7",
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
